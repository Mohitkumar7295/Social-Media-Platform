# ==============================================================================
# WriteSpace Application Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local environment configuration.
# DO NOT commit sensitive production credentials to version control.

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# ------------------------------------------------------------------------------
# 2. INSFORGE MANAGED POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Obtain these credentials from your InsForge project database settings dashboard.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.insforge.app:5432/writespace_db?sslmode=require
SPRING_DATASOURCE_USERNAME=writespace_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Connection Pool (HikariCP)
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1200000
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000

# ------------------------------------------------------------------------------
# 3. HIBERNATE & FLYWAY MIGRATION
# ------------------------------------------------------------------------------
# validate in production, validate in dev after initial flyway run
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ------------------------------------------------------------------------------
# 4. JWT SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key must be a base64-encoded or raw 256-bit (minimum 32 characters) string.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration in milliseconds: 86400000 ms = 24 hours
JWT_EXPIRATION_MS=86400000
# Refresh token expiration: 604800000 ms = 7 days
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 5. INSFORGE STORAGE / MEDIA ATTACHMENTS (OPTIONAL)
# ------------------------------------------------------------------------------
INSFORGE_STORAGE_ENDPOINT=https://storage.insforge.app
INSFORGE_STORAGE_BUCKET=writespace-media
INSFORGE_STORAGE_API_KEY=your_insforge_storage_api_key_here
MAX_AVATAR_SIZE_BYTES=2097152
MAX_COVER_IMAGE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# 6. LOGGING LEVEL
# ------------------------------------------------------------------------------
LOGGING_LEVEL_COM_WRITESPACE=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN
